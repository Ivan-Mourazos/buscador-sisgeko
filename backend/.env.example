# Puerto para el servidor (por defecto 5000)
PORT=5000

# Base de datos SQL Server
DB_SERVER=192.168.0.124
DB_NAME=SISGEKO
DB_USER=sisgeko
DB_PASSWORD=your_password

# Configuración de Correo SMTP
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# Cuenta con licencia de la empresa para autenticar (ej: rps@toldosgomez.com)
SMTP_USER=rps@toldosgomez.com
# Contraseña de la cuenta con licencia
SMTP_PASS=password
# Buzón compartido sin licencia con permisos "Enviar como" (ej: sisgeko@toldosgomez.com)
SMTP_FROM="Sisgeko Notificacións" <sisgeko@toldosgomez.com>
# Correos de destino alternativos si la base de datos no tiene la columna 'email' (separados por comas)
SMTP_FALLBACK_RECIPIENTS=admin@example.com,editor@example.com
# URL base de la aplicación para enlaces en el correo
APP_URL=http://localhost:5000
# Planificador: expresión cron (por defecto '0 8 * * 1-5' de lunes a viernes a las 08:00 AM)
SMTP_CRON_SCHEDULE=0 8 * * 1-5

# Configuración del Chatbot de IA (Ollama local o API OpenAI)
# Para simulación local, dejar AI_API_URL vacío
AI_API_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL_NAME=qwen2.5:0.5b
